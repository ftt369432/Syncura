rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: verify user belongs to household
    function isHouseholdMember(householdId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    // Households
    match /households/{householdId} {
      allow read, write: if request.auth != null;

      // Profiles sub-collection
      match /profiles/{profileId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      // Medications sub-collection
      match /medications/{medId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      // Regimen Rules sub-collection
      match /regimen_rules/{ruleId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      // Dose Logs sub-collection
      match /dose_logs/{logId} {
        allow read, create: if isHouseholdMember(householdId);
        allow update, delete: if false; // Immutable audit log
      }

      // Family Activity & Messages sub-collection
      match /family_messages/{msgId} {
        allow read, create: if isHouseholdMember(householdId);
      }

      // Inventory Transactions sub-collection
      match /inventory_transactions/{txId} {
        allow read, create: if isHouseholdMember(householdId);
      }
    }
  }
}
